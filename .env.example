# Copy to .env and fill in to enable real LLM reasoning.
# Without this set, the app still runs fully — agents fall back to
# fast rule-based logic (see app/llm.py).
ANTHROPIC_API_KEY=sk-ant-...
TRAVELPILOT_MODEL=claude-sonnet-4-6

# Optional — without this, Discovery Agent uses the local mock POI
# dataset (app/data/pois.json, Goa only). With it, any destination
# works via live Google Places Text Search.
GOOGLE_PLACES_API_KEY=

# Optional — set BOTH to gate the whole app behind a single shared
# login (browser's native prompt). Leave blank for open local dev.
# This is what you hand judges alongside the live link.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
